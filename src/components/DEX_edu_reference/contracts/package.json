{
  "name": "bitswapdex-smart-contracts",
  "version": "1.0.0",
  "description": "BitSwapDEX Smart Contracts - Solidity contracts pentru DEX",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bsc",
    "verify:testnet": "hardhat verify --network bscTestnet",
    "verify:mainnet": "hardhat verify --network bsc",
    "setup:chainlink": "hardhat run scripts/setupChainlinkBTC.js --network",
    "setup:manual": "hardhat run scripts/setupManualBTC.js --network",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "keywords": [
    "bitswapdex",
    "solidity",
    "smart-contracts",
    "dex",
    "bsc"
  ],
  "author": "BitSwapDEX Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.9"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2"
  }
}

